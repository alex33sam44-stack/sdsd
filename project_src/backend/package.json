{
  "name": "mwasalat-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "prisma:generate": "node scripts/prisma-generate-offline.mjs",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "lint": "eslint \"src/**/*.ts\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:ci": "jest --runInBand",
    "test:cov": "jest --coverage --runInBand",
    "tenant:backfill-legacy": "ts-node scripts/backfill-legacy-tenant.ts",
    "billing:seed-foundation": "ts-node scripts/seed-billing-foundation.ts",
    "release:verify": "ts-node scripts/release-verify.ts",
    "ci": "npm run prisma:generate && npm run lint && npm run test:cov && npm run build && npm run release:verify",
    "test:tenant-isolation:mysql": "node scripts/run-mysql-tenant-isolation.mjs",
    "tenant:isolation:mysql": "node scripts/run-mysql-tenant-isolation.mjs",
    "test:tenant-isolation:mysql:docker": "node scripts/run-mysql-tenant-isolation-with-docker.mjs",
    "tenant:isolation:mysql:docker": "node scripts/run-mysql-tenant-isolation-with-docker.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cookie-parser": "^1.4.7",
    "google-auth-library": "^9.14.0",
    "helmet": "^8.0.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^4.17.21",
    "@types/node": "^20.16.5",
    "@types/passport-jwt": "^4.0.1",
    "@types/uuid": "^10.0.0",
    "prisma": "^5.20.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4",
    "@nestjs/testing": "^10.4.0",
    "@types/jest": "^29.5.14",
    "@types/supertest": "^6.0.3",
    "@eslint/js": "^9.32.0",
    "eslint": "^9.32.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "typescript-eslint": "^8.38.0"
  },
  "description": "Self-hosted NestJS + Prisma + MySQL backend."
}
