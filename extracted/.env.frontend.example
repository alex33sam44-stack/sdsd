# Frontend build environment (Vite)
VITE_API_BASE_URL=https://api.yourdomain.com/api
VITE_APP_VERSION=2026.05.02
VITE_RELEASE_NAME=prod@2026-05-02
VITE_SENTRY_DSN=

# Optional Deep Dive marketing/growth routes migrated from prototype
# Required only when using /marketing, /trip, /invite, /channels, /alerts, etc.
VITE_LOVABLE_API_KEY=

# Optional: interactive maps without Google Maps. Host .pmtiles on CDN/object storage.
VITE_PMTILES_URL=https://cdn.example.com/maps/egypt-cairo.pmtiles
VITE_STREET_IMAGERY_PROVIDER=kartaview
# VITE_STREET_IMAGERY_URL_TEMPLATE=https://example.com/viewer?lat={lat}&lng={lng}&z={zoom}
