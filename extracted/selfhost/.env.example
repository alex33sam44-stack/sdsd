# Copy to .env.staging on the staging VPS/CI runner and replace all placeholders.
API_DOMAIN=staging.yourdomain.com
PUBLIC_URL=https://staging.yourdomain.com
CORS_ORIGIN=https://staging.yourdomain.com
MYSQL_ROOT_PASSWORD=replace-with-strong-root-password
MYSQL_DATABASE=mwasalat
MYSQL_USER=mwasalat
MYSQL_PASSWORD=replace-with-strong-user-password
JWT_ACCESS_SECRET=replace-with-48-random-bytes
JWT_REFRESH_SECRET=replace-with-different-48-random-bytes
APP_VERSION=staging
LOG_LEVEL=warn
SENTRY_DSN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://staging.yourdomain.com/api/auth/google/callback
APP_REDIRECT_URI=https://staging.yourdomain.com/auth/callback
BILLING_DEFAULT_PROVIDER=manual
BILLING_APP_URL=https://staging.yourdomain.com
BILLING_SUCCESS_URL=https://staging.yourdomain.com/admin/billing?checkout=success
BILLING_CANCEL_URL=https://staging.yourdomain.com/admin/billing?checkout=cancel
BILLING_PORTAL_RETURN_URL=https://staging.yourdomain.com/admin/billing
LEGACY_TENANT_SLUG=legacy-default
LEGACY_TENANT_NAME=Legacy Default Tenant
LEGACY_TENANT_COUNTRY_CODE=EG
LEGACY_TENANT_PLAN_CODE=legacy
LEGACY_TENANT_PLAN_STATUS=active
# Dynamic Open Graph previews for shared links (/t, /g, /c).
# SERVICE_ROLE gives best server-side preview fidelity; ANON works when RLS/RPC allows public read.
PUBLIC_APP_URL=https://app.example.com

# Frontend-only: PMTiles basemap URL for MapLibre live tracking maps.
# VITE_PMTILES_URL=https://cdn.example.com/maps/egypt-cairo.pmtiles
VITE_STREET_IMAGERY_PROVIDER=kartaview
# VITE_STREET_IMAGERY_URL_TEMPLATE=https://example.com/viewer?lat={lat}&lng={lng}&z={zoom}
