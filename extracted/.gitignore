# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Release evidence logs MUST be tracked — they are deterministic
# verifier outputs, not application logs. Negation overrides the
# global *.log ignore above.
!release-evidence/**/*.log

node_modules
dist
dist-ssr
*.local

