# --- Server ---
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# --- Database (MySQL) ---
DATABASE_URL="mysql://user:password@localhost:3306/mwasalat"

# --- Release / observability ---
APP_VERSION=dev
LOG_LEVEL=warn
SENTRY_DSN=

# --- JWT ---
JWT_ACCESS_SECRET=replace-me-32-bytes-min
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-me-32-bytes-min
JWT_REFRESH_TTL=30d

# --- Google OAuth (BYOK) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback
APP_REDIRECT_URI=http://localhost:5173/auth/callback


# --- Multi-tenancy bootstrap (legacy backfill) ---
LEGACY_TENANT_SLUG=legacy-default
LEGACY_TENANT_NAME="Legacy Default Tenant"
LEGACY_TENANT_COUNTRY_CODE=EG
LEGACY_TENANT_PLAN_CODE=legacy
LEGACY_TENANT_PLAN_STATUS=active



# --- Email verification for password registration ---
# Use EMAIL_VERIFICATION_DELIVERY=log only in local development. Production must use smtp.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_DELIVERY=log
EMAIL_VERIFICATION_EXPOSE_DEV_LINK=true
EMAIL_VERIFICATION_BASE_URL=http://localhost:4000/api/auth/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_FROM="Mwasalat <no-reply@localhost>"
SMTP_USER=
SMTP_PASS=

# --- Billing providers / checkout lifecycle ---
BILLING_DEFAULT_PROVIDER=manual
BILLING_APP_URL=http://localhost:5173
BILLING_SUCCESS_URL=http://localhost:5173/admin/billing?checkout=success
BILLING_CANCEL_URL=http://localhost:5173/admin/billing?checkout=cancel
BILLING_PORTAL_RETURN_URL=http://localhost:5173/admin/billing

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_VARIANT_STARTER_MONTHLY=
LEMON_VARIANT_STARTER_YEARLY=
LEMON_VARIANT_GROWTH_MONTHLY=
LEMON_VARIANT_GROWTH_YEARLY=
LEMON_VARIANT_ENTERPRISE_MONTHLY=
LEMON_VARIANT_ENTERPRISE_YEARLY=
