# Frontend production build env for Vite.
# This file is consumed by the Docker frontend build and must match selfhost/.env.production.
# Configure it with:
#   APP_DOMAIN=app.example.com API_DOMAIN=api.example.com ./selfhost/scripts/configure-production-env.sh
VITE_API_BASE_URL=https://api.mwasalat.com/api
VITE_APP_VERSION=production
VITE_RELEASE_NAME=production
VITE_SENTRY_DSN=
