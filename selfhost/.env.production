BILLING_CANCEL_URL=https://app.mwasalat.com/admin/billing?checkout=cancel
BILLING_PORTAL_RETURN_URL=https://app.mwasalat.com/admin/billing

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_VARIANT_STARTER_MONTHLY=
LEMON_VARIANT_STARTER_YEARLY=
LEMON_VARIANT_GROWTH_MONTHLY=
LEMON_VARIANT_GROWTH_YEARLY=
LEMON_VARIANT_ENTERPRISE_MONTHLY=
LEMON_VARIANT_ENTERPRISE_YEARLY=


# ---- Multi-tenancy bootstrap ------------------------------------------------
LEGACY_TENANT_SLUG=legacy-default
LEGACY_TENANT_NAME="Legacy Default Tenant"
LEGACY_TENANT_COUNTRY_CODE=EG
LEGACY_TENANT_PLAN_CODE=legacy
LEGACY_TENANT_PLAN_STATUS=active


# ---- Email verification for password registration -------------------------
# Password sign-up is blocked from logging in until this email is verified.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_DELIVERY=smtp
EMAIL_VERIFICATION_BASE_URL=https://api.mwasalat.com/api/auth/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_FROM="Mwasalat <no-reply@mwasalat.com>"
SMTP_USER=
SMTP_PASS=

# ---- MySQL backups ----------------------------------------------------------
# Local backup retention on the VPS.
BACKUP_RETENTION_DAYS=14
# External/off-site retention.
BACKUP_REMOTE_RETENTION_DAYS=30
# Option A: external mounted directory, for example /mnt/backups/mwasalat-mysql.
# Keep blank if using rclone.
BACKUP_REMOTE_DIR=/mnt/mwasalat-backups/mysql
# Option B: rclone remote path, for example s3:mwasalat-prod-backups/mysql.
# Takes priority over BACKUP_REMOTE_DIR when set.
BACKUP_RCLONE_REMOTE=
# Public launch requires a verified external/off-site target.
# Keep true unless you are doing local-only development.
BACKUP_REQUIRE_EXTERNAL_TARGET=true
# When using BACKUP_REMOTE_DIR, require it to be a separate mounted filesystem.
BACKUP_REMOTE_DIR_REQUIRE_MOUNT=true
# Verify target writability before mysqldump/deploy.
BACKUP_VERIFY_TARGET_BEFORE_BACKUP=true
BACKUP_TARGET_VERIFY_WRITE=true
# Per-run safety: the nightly script refuses to leave the only copy on the
# application filesystem and re-checks the off-site copy after every run.
BACKUP_REQUIRE_OFFSITE_COPY=true
BACKUP_VERIFY_OFFSITE_AFTER_COPY=true

# Automated deployment rollback
DEPLOY_ROOT=/opt/mwasalat
COMPOSE_PROJECT_NAME=mwasalat
HEALTH_RETRIES=18
HEALTH_INTERVAL_SECONDS=10
RUN_BACKUP_BEFORE_DEPLOY=true
KEEP_RELEASES=5

# Frontend build-time API endpoint for the Docker frontend service.
VITE_API_BASE_URL=https://api.mwasalat.com/api
