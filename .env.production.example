# ============================================================================
# Production env file for `docker compose --env-file .env.production up -d`
# Copy to `.env.production` on the VPS and fill in real values. NEVER commit.
# ============================================================================

# ---- Public hostname for the API (must have an A record -> VPS IP) ----------
APP_DOMAIN=app.yourdomain.com
API_DOMAIN=api.yourdomain.com
PUBLIC_URL=https://api.yourdomain.com

# ---- CORS: exact origin(s) of your frontend (comma-separated, no trailing /) -
# Include every origin that will call the API:
#   - the production app domain
#   - the Lovable preview origin (id-preview--<uuid>.lovable.app) during cutover
CORS_ORIGIN=https://app.yourdomain.com,https://id-preview--f5422247-2a20-464e-a9b7-eec19669a02f.lovable.app

# ---- MySQL (kept on internal docker network, not exposed) ------------------
MYSQL_ROOT_PASSWORD=change-me-strong-root-pass
MYSQL_DATABASE=mwasalat
MYSQL_USER=mwasalat
MYSQL_PASSWORD=change-me-strong-user-pass

# ---- Backend release / observability ---------------------------------------
APP_VERSION=2026.05.02
LOG_LEVEL=warn
SENTRY_DSN=

# ---- JWT secrets (generate each with: openssl rand -base64 48) -------------
JWT_ACCESS_SECRET=replace-with-48-random-bytes
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace-with-DIFFERENT-48-random-bytes
JWT_REFRESH_TTL=30d

# ---- Google OAuth (optional — leave blank to disable "Continue with Google") -
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback
APP_REDIRECT_URI=https://app.yourdomain.com/auth/callback



# ---- Email verification for password registration -------------------------
# Public launch requires real SMTP credentials. Password users cannot login
# until they verify the email sent by /api/auth/register.
EMAIL_VERIFICATION_REQUIRED=true
EMAIL_VERIFICATION_DELIVERY=smtp
EMAIL_VERIFICATION_BASE_URL=https://api.yourdomain.com/api/auth/verify-email
EMAIL_VERIFICATION_TOKEN_TTL_MINUTES=60
SMTP_HOST=smtp.your-provider.example
SMTP_PORT=587
SMTP_SECURE=false
SMTP_STARTTLS=true
SMTP_FROM="Mwasalat <no-reply@yourdomain.com>"
SMTP_USER=
SMTP_PASS=

# ---- Billing providers (optional — leave blank to keep manual billing) ------
BILLING_DEFAULT_PROVIDER=manual
BILLING_APP_URL=https://app.yourdomain.com
BILLING_SUCCESS_URL=https://app.yourdomain.com/admin/billing?checkout=success
BILLING_CANCEL_URL=https://app.yourdomain.com/admin/billing?checkout=cancel
BILLING_PORTAL_RETURN_URL=https://app.yourdomain.com/admin/billing

STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_STARTER_MONTHLY=
STRIPE_PRICE_STARTER_YEARLY=
STRIPE_PRICE_GROWTH_MONTHLY=
STRIPE_PRICE_GROWTH_YEARLY=
STRIPE_PRICE_ENTERPRISE_MONTHLY=
STRIPE_PRICE_ENTERPRISE_YEARLY=

LEMON_SQUEEZY_API_KEY=
LEMON_SQUEEZY_STORE_ID=
LEMON_SQUEEZY_WEBHOOK_SECRET=
LEMON_VARIANT_STARTER_MONTHLY=
LEMON_VARIANT_STARTER_YEARLY=
LEMON_VARIANT_GROWTH_MONTHLY=
LEMON_VARIANT_GROWTH_YEARLY=
LEMON_VARIANT_ENTERPRISE_MONTHLY=
LEMON_VARIANT_ENTERPRISE_YEARLY=


# ---- Multi-tenancy bootstrap (run once after import) -----------------------
LEGACY_TENANT_SLUG=legacy-default
LEGACY_TENANT_NAME="Legacy Default Tenant"
LEGACY_TENANT_COUNTRY_CODE=EG
LEGACY_TENANT_PLAN_CODE=legacy
LEGACY_TENANT_PLAN_STATUS=active

# ============================================================================
# Frontend (Lovable / Vite) — set these in the FRONTEND environment, not here.
# Documented for convenience so the VPS operator and frontend dev stay aligned:
#
#   VITE_API_BASE_URL=https://api.yourdomain.com/api
#
# After the backend reports /api/health = {status:"ok",db:"up"}, set the
# frontend variable above and rebuild the frontend. Then the cutover loop
# ============================================================================

# Optional frontend release metadata / observability
# Set these in the frontend build environment (not in the backend container):
# VITE_APP_VERSION=2026.05.02
# VITE_RELEASE_NAME=prod@2026-05-02
# VITE_SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0

# ---- External MySQL backups ------------------------------------------------
# Public launch requires one verified external target. Prefer rclone/S3.
BACKUP_RCLONE_REMOTE=s3:mwasalat-prod-backups/mysql
BACKUP_REMOTE_DIR=
BACKUP_REQUIRE_EXTERNAL_TARGET=true
BACKUP_REMOTE_DIR_REQUIRE_MOUNT=true
BACKUP_VERIFY_TARGET_BEFORE_BACKUP=true
BACKUP_TARGET_VERIFY_WRITE=true
# Per-run safety: the nightly script refuses to leave the only copy on the
# application filesystem. Keep both `true` unless you know what you are doing.
BACKUP_REQUIRE_OFFSITE_COPY=true
BACKUP_VERIFY_OFFSITE_AFTER_COPY=true
# Dynamic Open Graph previews for shared links (/t, /g, /c).
# SERVICE_ROLE gives best server-side preview fidelity; ANON works when RLS/RPC allows public read.
PUBLIC_APP_URL=https://app.example.com

# ---- Community / marketing surface ----------------------------------------
# The community features (alerts, channels, chat, group trips, leaderboard,
# public profiles…) currently use a localStorage-only data layer and are NOT
# wired to the backend yet. Default in production builds is OFF so users
# don't post into per-browser fake data. Set this to "true" only after the
# migration in `docs/COMMUNITY_FEATURES_MIGRATION.md` lands.
VITE_COMMUNITY_FEATURES_ENABLED=false

# Frontend-only: PMTiles basemap URL for MapLibre live tracking maps.
# VITE_PMTILES_URL=https://cdn.example.com/maps/egypt-cairo.pmtiles
VITE_STREET_IMAGERY_PROVIDER=kartaview
# VITE_STREET_IMAGERY_URL_TEMPLATE=https://example.com/viewer?lat={lat}&lng={lng}&z={zoom}
